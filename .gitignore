# ADS drops these into whatever directory it is started from
de_sim.cfg
hpeesofsim.cfg

.venv
__pycache__/
*.pyc
plots/

# Vendor PDK: licensed design kit, not redistributable
ADS_workspace/MA_RFP_ADS_v1p8/

# Simulation datasets and signal files: several GB, regenerated by the scripts.
# Only the compressed LTE stimulus is kept; adsenv.sh --setup unpacks it.
ADS_workspace/data/*
!ADS_workspace/data/LTE_DL_7p68MSPS_5M_SR_122.88.txt.xz

# Machine-specific config ADS rewrites on open (absolute paths, file history)
ADS_workspace/ADSlibconfig
ADS_workspace/dds.cfg

# ADS scratch: generated netlists, backups, locks, logs, caches, GUI state
circ*.ckt
circ*.ckt.out
*~
*.cdslck*
*.broken/
*.log
*.upl
*.lnk
spectra.raw
saved.wrkstate
*_data/
Cached_Imp/
dc_annotation/
simulation/
